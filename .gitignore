# Playwright/browser-gate run output. Durable evidence is curated under the
# workstream evidence directory instead of committing the runner's scratch state.
apps/web/tests/test-results/
packages/panel/test-results/
/test-results/

# Local agent metadata and Blender recovery copies are not source assets.
/.neuve/
/.neuve-artifact/
*.blend1

# Agent instructions live in AGENTS.md. CLAUDE.md is a symlink to it, created
# locally by whoever needs it, so the repo carries exactly one copy of the law.
.claude/
CLAUDE.md

# Signing keys and credentials. The MusicKit private key signs the developer
# token and must never reach the client, a commit, a log, a doc, or an agent
# prompt. Token minting is server-side only (pm-spec §14.1).
cert/
*.p8
*.pem
*.key
*.p12

# Manifest-verified assets copied by Vite config for dev and production.
/apps/web/public/stickers/playworn/
