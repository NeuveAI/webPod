        {
          "type": "text",
          "id": "IN375",
          "x": 46,
          "y": 859,
          "name": "Recreated inspiration disclosure",
          "fill": "#434343",
          "content": "RECREATED INSPIRATION — original AI composition; historical sources inform the visual language only.",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "VxV4e",
          "x": 1054,
          "y": 606,
          "name": "Identity rationale",
          "fill": "#292929",
          "textGrowth": "fixed-width",
          "width": 432,
          "content": "ONE FACTORY. TWO VOLUMES.\n\nA pale cut edge, worn print and tiny catalogue mark bind every silhouette. Genre changes the ink and attitude; the object stays familiar.",
          "lineHeight": 1.25,
          "fontFamily": "Space Grotesk",
          "fontSize": 22,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "twtPI",
          "x": 1054,
          "y": 803,
          "name": "Physical rule",
          "fill": "#292929",
          "textGrowth": "fixed-width",
          "width": 432,
          "content": "IVORY VINYL / SATIN FACE\nFINE PRINT GRAIN / 0.8 mm EDGE\nOPTIONAL SILVER ≤ 10% OF FACE",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "TRWaP",
          "x": 46,
          "y": 938,
          "name": "01 / XEROX & NIGHTLIFE",
          "fill": "#171717",
          "content": "01 / XEROX & NIGHTLIFE",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "N1pJ3z",
          "x": 46,
          "y": 974,
          "name": "01 / XEROX & NIGHTLIFE source note",
          "fill": "#434343",
          "textGrowth": "fixed-width",
          "width": 450,
          "content": "V&A: Plastic People Letraset flyers, 1998.\nTransfer type, mono contrast and paper friction.\nBorrow the process — never the band mark.",
          "lineHeight": 1.4,
          "fontFamily": "Space Grotesk",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "M5IHZ",
          "x": 545,
          "y": 938,
          "name": "02 / SCENE IN YOUR POCKET",
          "fill": "#171717",
          "content": "02 / SCENE IN YOUR POCKET",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Arp0G",
          "x": 545,
          "y": 974,
          "name": "02 / SCENE IN YOUR POCKET source note",
          "fill": "#434343",
          "textGrowth": "fixed-width",
          "width": 450,
          "content": "V&A Dundee: club graphics across tickets,\nstickers and sleeves. Identity travels with you.\nTranslate ephemera into collectible die-cuts.",
          "lineHeight": 1.4,
          "fontFamily": "Space Grotesk",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "qvSbf",
          "x": 1054,
          "y": 938,
          "name": "03 / A PERSONAL MIX",
          "fill": "#171717",
          "content": "03 / A PERSONAL MIX",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "EQ8R1",
          "x": 1054,
          "y": 974,
          "name": "03 / A PERSONAL MIX source note",
          "fill": "#434343",
          "textGrowth": "fixed-width",
          "width": 432,
          "content": "Our interpretation: chrome CD shine meets\nblack Xerox grit and candy ink.\nA collection from the same imagined shop.",
          "lineHeight": 1.4,
          "fontFamily": "Space Grotesk",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "bqWWa",
          "x": 46,
          "y": 1110,
          "name": "Exploration footer",
          "fill": "#55534E",
          "content": "PROPOSED COLLECTION  /  ORIGINAL MOTIFS  /  UNLOCK CONDITIONS ARE ILLUSTRATIVE",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
