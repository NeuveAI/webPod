# Vercel source uploads must obey the same credential boundary as Docker.
!.dockerignore
cert/
**/cert/**
.env*
**/.env*
*.p8
**/*.p8
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
.data/
**/.data/**
**/*.sqlite*
**/*.db*
node_modules/
**/node_modules/**
**/dist/**
**/.output/**
**/.tanstack/**
.git/
.claude/
.neuve/
.neuve-artifact/
docs/
design.pen
assets/hand/
assets/brand/
**/test-results/**
**/*.log
