          "x": 48,
          "y": 77,
          "name": "Material headline",
          "fill": "#20211F",
          "content": "Different noise.\nSame skin.",
          "lineHeight": 0.98,
          "fontFamily": "Archivo Black",
          "fontSize": 68,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "e11Ic5",
          "x": 830,
          "y": 93,
          "name": "Material premise",
          "fill": "#41423D",
          "textGrowth": "fixed-width",
          "width": 545,
          "content": "A family of small, earned objects.\nInk has a little history; vinyl still catches the light.\nOne warm cutline holds the extremes together.",
          "lineHeight": 1.4,
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
