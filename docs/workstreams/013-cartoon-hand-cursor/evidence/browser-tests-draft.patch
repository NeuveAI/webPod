+test('fast mouse movement smears briefly and reduced motion disables smears', async ({ page }) => {
+  await page.goto('/_spike/device', { waitUntil: 'domcontentloaded' })
+  const hand = page.locator('.webpod-hand-cursor')
+  await expect(hand).toHaveAttribute('data-hand-cursor', 'ready')
+  await page.mouse.move(120, 250)
+  await expect(hand).toHaveCSS('visibility', 'visible')
+  // Real mouse input sampled while it moves; no special test-only product API.
+  const samples = page.evaluate(async () => {
+    const values: number[] = []
+    const end = performance.now() + 900
+    while (performance.now() < end) {
+      values.push(Number(document.querySelector('.webpod-hand-cursor')?.getAttribute('data-hand-smear') ?? 0))
+      await new Promise(requestAnimationFrame)
+    }
+    return values
+  })
+  for (let i = 0; i < 4; i++) {
+    await page.mouse.move(120, 250)
+    await page.mouse.move(1050, 350, { steps: 5 })
+  }
+  expect(Math.max(...await samples)).toBeGreaterThan(.1)
+  await expect(hand).toHaveAttribute('data-hand-smear', '0.000')
+  await page.emulateMedia({ reducedMotion: 'reduce' })
+  await page.mouse.move(120, 250, { steps: 5 })
+  await expect(hand).toHaveAttribute('data-hand-motion', 'reduced')
+  await expect(hand).toHaveAttribute('data-hand-smear', '0.000')
+  await page.keyboard.press('Tab')
+  await expect(hand).toHaveCSS('visibility', 'hidden')
+  await expect(page.locator('html')).not.toHaveAttribute('data-hand-cursor-active')
+})
+
