        {
          "type": "text",
          "id": "XMcXi",
          "x": 48,
          "y": 884,
          "name": "Hero caption",
          "fill": "#20211F",
          "content": "01  INK CAN CHANGE ITS VOICE",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "aEh0j",
          "x": 48,
          "y": 916,
          "name": "Hero description",
          "fill": "#484943",
          "textGrowth": "fixed-width",
          "width": 810,
          "content": "Carbon + bone ↔ candy spot colours. Tiny pores, halftone and imperfect registration live in the print, never in a fake distressed border.",
          "lineHeight": 1.35,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "N0Ale7",
          "x": 934,
          "y": 676,
          "name": "Edge caption",
          "fill": "#20211F",
          "content": "02  THE EDGE IS THE SIGNATURE",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "O8wTL",
          "x": 934,
          "y": 708,
          "name": "Edge description",
          "fill": "#484943",
          "textGrowth": "fixed-width",
          "width": 458,
          "content": "Warm ivory vinyl. Fine die-cut perimeter.\nLow satin sheen, small tactile lift.\nWear in the ink; laminate kept intact.",
          "lineHeight": 1.4,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "normal"
        },
